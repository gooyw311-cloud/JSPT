{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cl",
            "args": [
                "/EHsc",
                "/Zi",
                "/Fe:program.exe",
                "JSPT/源.cpp",
                "JSPT/read_instances.cpp",
                "JSPT/random.cpp",
                "JSPT/Chromosome.cpp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
